{
  "format_on_save": "on",
  "prettier": {
    "allowed": false
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["oxfmt", "oxlint", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "TSX": {
      "language_servers": ["oxfmt", "oxlint", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "JavaScript": {
      "language_servers": ["oxfmt", "oxlint", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "JSX": {
      "language_servers": ["oxfmt", "oxlint", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
    "JSON": {
      "language_servers": ["oxfmt", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSONC": {
      "language_servers": ["oxfmt", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "HTML": {
      "language_servers": ["oxfmt", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "CSS": {
      "language_servers": ["oxfmt", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "Markdown": {
      "language_servers": ["oxfmt", "..."],
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    }
  },
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "typeAware": true,
          "fixKind": "safe_fix"
        }
      }
    }
  }
}
